# 복사해서 .env 로 사용하세요:  cp .env.example .env
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/adgen
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# 기본 모델이 한도 초과(429)/서버 오류일 때 순서대로 시도할 모델 (쉼표 구분, 모델마다 한도가 별도)
GEMINI_FALLBACK_MODELS=
# Gemini 요청 타임아웃(초)
GEMINI_TIMEOUT_SEC=90

# API 사용 모드 — 반복 테스트로 Gemini 한도가 부족할 때 한 줄로 전환
#   live    : 아래 개별 설정 그대로
#   saver   : 대본만 Gemini, TTS는 gTTS 고정
#   offline : Gemini 호출 없음 (원문 기반 템플릿 대본 + gTTS) — UI·렌더링 반복 테스트용
API_MODE=live
# 대본 생성: gemini | mock (API_MODE=offline이면 mock 고정)
LLM_PROVIDER=gemini
# 모든 Gemini 모델이 한도 초과일 때 mock이면 템플릿 대본으로 대체, 비우면 오류 메시지 표시
LLM_FALLBACK=
# 백그라운드 대본 생성 중 한도 대기 시간이 이 값(초) 이하면 기다렸다가 재시도
LLM_MAX_WAIT_SEC=60
# LLM에 전달할 원문 최대 글자 수
SOURCE_TEXT_MAX_CHARS=30000
MEDIA_DIR=media

# TTS: gemini (Gemini TTS, 같은 API 키 사용, WAV) | gtts (무료, MP3)
# 개발·테스트 중 Gemini 무료 한도(분당 3회)가 부족하면 TTS_PROVIDER=gtts 로 두세요.
TTS_PROVIDER=gemini
# 기본 엔진이 한도 초과(429)/서버 오류일 때 즉시 폴백할 엔진 (빈 값이면 폴백 없이 대기·재시도)
TTS_FALLBACK=gtts
TTS_MODEL=gemini-3.8-flash-tts
# Gemini 프리셋 보이스 (예: Charon, Kore, Puck, Fenrir, Aoede ...)
TTS_VOICE=Charon
# 말투·템포 지시 — 대본과 분리된 별도 필드(speech_metadata.style)로 전달되어 소리로 읽히지 않음. 짧은 묘사형 권장
TTS_STYLE=빠른 템포, 리듬감 있고 또렷한 숏폼 광고 내레이션

# ---------- 영상 렌더링 (FFmpeg) ----------
# ffmpeg 경로. 비우면 imageio-ffmpeg 번들(pip 설치 시 자동 포함) → 시스템 PATH 순으로 탐색
FFMPEG_PATH=
# 자막 폰트. 비우면 맑은 고딕 Bold 등 OS 기본 한글 폰트 사용
RENDER_FONT_PATH=
# 배경 카메라 무빙 (씬마다 줌인/줌아웃/팬 + 시작 펀치 줌)
RENDER_KEN_BURNS=true
# 무빙 세기 배수 (0.5 잔잔 ~ 1.5 과감)
RENDER_MOTION_STRENGTH=1.0
# 내레이션을 짧은 구절로 끊어 말소리에 맞춰 보여주는 자막
RENDER_NARRATION_CAPTION=true
# 상단 고정 제목(훅 문구) + 도서명 라벨
RENDER_TITLE_BAR=true
# 씬 전환: auto(씬마다 다른 효과) | none | xfade 이름 (fade, slideleft, smoothup, zoomin, circleopen ...)
RENDER_TRANSITION=auto
RENDER_TRANSITION_SEC=0.35
# 전환 시 짧은 '휙' 효과음
RENDER_TRANSITION_SFX=true
# 씬마다 내레이션 뒤에 둘 여백(초) — 쇼츠 템포를 위해 짧게
RENDER_SCENE_PADDING_SEC=0.15
# 호스트 캐릭터
#   character: HOST_POSE_DIR의 포즈 이미지로 대본 감정선에 맞춰 연기하는 캐릭터 카드 (하단, 씬마다 자리 이동)
#   avatar   : HOST_IMAGE 한 장을 원형 아바타로 왼쪽에 고정
#   auto     : 포즈 폴더에 이미지가 있으면 character, 없으면 avatar / off: 끄기
HOST_ENABLED=true
HOST_MODE=auto
# 포즈 이미지 폴더. 기본 매핑: 00 놀람, 01 가리키기, 02 인사, 03 생각, 04 확신
# 다른 파일을 쓰려면 폴더에 poses.json 작성: {"surprised": "00.png", "thinking": "03.png", ...}
HOST_POSE_DIR=media/images/JB
HOST_IMAGE=media/images/JB.png
# 아바타로 쓸 정사각형 영역 "x,y,크기" (비우면 이미지 중앙 상단)
HOST_CROP=830,20,480
HOST_NAME=JB
# BGM: 파일 또는 폴더(첫 번째 음원). 없으면 기본 붐뱁 비트를 합성해 사용 (BGM_GENERATE)
BGM_ENABLED=true
BGM_PATH=media/bgm
BGM_GENERATE=true
BGM_VOLUME=0.25
# 내레이션이 나오면 BGM 자동으로 줄이기 (사이드체인 덕킹)
BGM_DUCKING=true
# x264 인코딩 속도/품질 (ultrafast ~ slow, CRF 낮을수록 고화질)
RENDER_PRESET=veryfast
RENDER_CRF=21
RENDER_TIMEOUT_SEC=900


# ---- AI 씬 영상 (Luma, Image-to-Video) ----
# 키가 있고 API_MODE=live이면 씬마다 JB 포즈 이미지로 캐릭터 연기 영상을 생성해 배경으로 사용.
# 키가 없거나 실패한 씬은 기존 렌더링(캐릭터 카드 + 켄 번즈)으로 자동 대체. 생성 결과는 media/clips/에 캐시.
# 키 형식으로 API 자동 선택: luma-api-… (platform.lumalabs.ai, Agents API) / luma-… (예전 Dream Machine API)
LUMA_API_KEY=
LUMA_ENABLED=true
# 비우면 키 종류에 맞는 기본값 (luma-api- 키: https://agents.lumalabs.ai/v1, ray-3.2 / 예전 키: dream-machine/v1, ray-2)
LUMA_API_BASE=
LUMA_MODEL=
LUMA_RESOLUTION=720p
LUMA_DURATION=5s
# 포즈 이미지 전달: luma-api- 키는 비워 두면 이미지를 요청에 직접 담아 보냄(공개 URL 불필요).
# 예전 키는 공개 URL만 받으므로 이 서버의 /media가 외부에서 열리는 주소 필요 (예: https://my-tunnel.ngrok.app)
LUMA_IMAGE_BASE_URL=
# 씬 첫 프레임: generate = 씬 '영상 프롬프트' + JB 포즈 이미지(캐릭터 레퍼런스)로 uni-1이 장면 키프레임을 만든 뒤
#   그 키프레임에서 영상 생성 (프롬프트의 장소·구도·조명이 반영됨, 씬마다 이미지 1장 추가 비용)
#   pose = JB 포즈 이미지를 그대로 첫 프레임으로 (저렴, 대신 포즈 이미지의 배경·구도에서 시작)
LUMA_SCENE_FRAME=generate
LUMA_IMAGE_MODEL=uni-1
# 여자주인공 기본값 (에피소드 생성 화면에서 등장 여부·폴더·대표 이미지를 고름)
HEROINE_DIR=media/images/caoting
HEROINE_CHARACTER=a graceful young East Asian woman with long dark hair in an elegant white qipao-style dress
HEROINE_MAX_REFS=3
# 프롬프트 속 캐릭터 외형 (씬마다 얼굴·옷이 바뀌지 않도록 고정)
LUMA_CHARACTER=the young Korean man with dark tousled hair in a red hoodie
LUMA_CONCURRENCY=4
LUMA_POLL_SEC=5
LUMA_TIMEOUT_SEC=600
